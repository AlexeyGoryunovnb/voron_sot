clc; close; clear;

W = 400;
H = 300;

N = 150;
% rng(2)

% xbs = randn(1,N);
% ybs = randn(1,N);
% xbs = (xbs-min(xbs));
% xbs = xbs/max(xbs)*W;
% xbs = sort(xbs);
% ybs = (ybs-min(ybs));
% ybs = ybs/max(ybs)*H;


xbs = randi([1,W],1,N);
xbs = sort(xbs);
ybs = randi([1,H],1,N);
f = 0;
for i = 1:N
    nodin = sum(xbs==xbs(i));
    if nodin>1 && f<1
        f=nodin;
        ybs(i:i+nodin-1)=sort(ybs(i:i+nodin-1));
    end
    f=f-1;
end

% xbs = [90 100 150 170 190 200 250 290 300];
% ybs = [75 225 150 67 75 255 150 280 75];
% N = length(xbs);

Pbs = ones(1,N);
% Pbs = rand(1,N)+1;

Cbs = randi([0,255],3,N);
% Cbs = [255 255 255 0 0 0 0 255 127;0 255 0 255 255 0 0 255 127;0 0 255 0 255 255 0 255 127];

colourmap = zeros(H,W,3);
for i = 1:W
    for j = 1:H
        TO = 0;
        PB = 0;
        for BS = 1:N
            if PB<Pbs(BS)/((i-xbs(BS))^2+(j-ybs(BS))^2)
                TO = BS;
                PB = Pbs(BS)/((i-xbs(BS))^2+(j-ybs(BS))^2);
            end
        end
        colourmap(j,i,:) = Cbs(:,TO);
    end
end
image(colourmap/255);
hold on
scatter(xbs,ybs,'black');
